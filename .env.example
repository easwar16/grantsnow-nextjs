# Local DEV setup: `cp .env.example .env.local`, then fill in the three secrets marked SECRET below
# (ask the team lead privately; never commit them). Everything else already points at the GrantsNow DEV environment.
APP_ORIGIN=http://localhost:3000
APP_ENV=development
FIXTURE_MODE=false
# DEV sign-in: paste your GrantsNow `token` cookie on /login (as in GN-Angular). Development only; forbidden in
# production/staging. See docs/dev-browser-session.md.
DEV_BROWSER_SESSION=true
# Absolute private file, mode 0600, for a captured DB token and its verified expiry (optional with the paste login).
DEV_BROWSER_SESSION_FILE=
# SECRET: a random key of at least 32 characters, e.g. `openssl rand -base64 48`. Identical on all instances.
SESSION_PASSWORD=
# GrantsNow DEV ORDS roots (end with /).
ORDS_BASE_URL=https://ioylug8aqineph1-preawards.adb.uk-london-1.oraclecloudapps.com/ords/dev_base/
ORDS_APPS_URL=https://ioylug8aqineph1-preawards.adb.uk-london-1.oraclecloudapps.com/ords/dev/
# Live Oracle writes (saves) stay off until a named test needs them (GN-Angular D27); set true only to test a save.
WRITES_ENABLED=false
# EOI/dynamic-form file storage: Object Storage through OIC, server-side only (Basic auth; never sent to the browser).
OIC_BASE_URL=https://grantsnow-lrmcnt71nt9l-ld.integration.ocp.oraclecloud.com
# SECRET: the OIC interface user and password (from the OIC admin). Blank keeps file storage off; everything else works.
GN_OIC_USER=
GN_OIC_PASSWORD=
# External drawer tools (open in a new tab; HTTPS, no credentials; blank hides the entry).
APEX_REPORTS_URL=https://ioylug8aqineph1-preawards.adb.uk-london-1.oraclecloudapps.com/ords/r/dev/preawards/reports
APEX_ADMINISTRATION_URL=https://ioylug8aqineph1-preawards.adb.uk-london-1.oraclecloudapps.com/ords/r/dev/preawards/home
CUSTOMER_SUPPORT_URL=https://ioylug8aqineph1-preawards.adb.uk-london-1.oraclecloudapps.com/ords/r/fp_ticketing_uat_wksp/fpsupport/home
# GrantsNow chatbot root, called server-side only (POST /query/ with the session token); blank hides the launcher.
# Legacy catalog: DEV http://140.238.102.187:8000, DEMO :8001, UAT/stage/prod :8003 (plain HTTP). Also needs global var CHATBOT_ENABLED=Y.
CHATBOT_URL=http://140.238.102.187:8000

# ---- Not needed for local DEV (the paste-token login above). For real IDCS sign-in and a service account: ----
# Exact advertised issuer; it can differ from the tenant host. No guessed issuer.
IDCS_ISSUER=
# Fixed administrator-approved tenant HTTPS discovery document URL.
IDCS_DISCOVERY_URL=
# Match the dedicated client's registration: client_secret_basic or client_secret_post.
IDCS_CLIENT_AUTH_METHOD=
IDCS_CLIENT_ID=
IDCS_CLIENT_SECRET=
IDCS_SCOPES=openid profile
# Identity owner must approve the claim and mapping; no default username claim.
IDCS_USERNAME_CLAIM=
# Set only after confirming discovery, S256/nonce and registered URLs with owner.
IDCS_COMPATIBILITY_CONFIRMED=false
# callback = APP_ORIGIN/api/auth/callback; logout return = APP_ORIGIN/login
# Approved independent service account mechanism: basic or bearer.
ORDS_AUTH_MODE=
ORDS_SERVICE_USERNAME=
ORDS_SERVICE_PASSWORD=
ORDS_SERVICE_BEARER=
# Must be approved by backend owner; a username header alone never suffices.
ORDS_TRUST_CONFIRMED=false
