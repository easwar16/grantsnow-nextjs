{
  "name": "grantsnow-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "dev:inspect": "node --experimental-network-inspection node_modules/next/dist/bin/next dev --hostname localhost --inspect",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "dompurify": "3.4.17",
    "downshift": "9.4.0",
    "driver.js": "1.10.2",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "iron-session": "9.0.1",
    "jsdom": "30.1.3",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "moment": "2.31.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "openid-client": "6.8.8",
    "quill": "2.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "undici": "8.12.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/jsdom": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
